<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         IgnorableNamespaces="rescap">

  <Identity Name="DeskWidgets"
            Publisher="CN=DeskWidgets"
            Version="1.8.1.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Desk Widgets</DisplayName>
    <PublisherDisplayName>Desk Widgets</PublisherDisplayName>
    <Description>Lightweight desktop widgets for Windows</Description>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DeskWidgets"
                 Executable="DeskWidgets.exe"
                 EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements DisplayName="Desk Widgets"
                          Description="Lightweight desktop widgets for Windows"
                          BackgroundColor="transparent"
                          Square150x150Logo="assets\Square150x150Logo.png"
                          Square44x44Logo="assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Autostart: MSIX replaces the registry Run key. The app toggles this via
             Windows.ApplicationModel.StartupTask at runtime. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="DeskWidgetsStartup"
                               Enabled="false"
                               DisplayName="Desk Widgets" />
        </desktop:Extension>

        <!-- deskwidgets://install/<id>/<version> deep links from the website -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="deskwidgets">
            <uap:DisplayName>Desk Widgets Install</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
